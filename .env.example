# Copy this file to .env.local and adjust values as needed.
#
# IMPORTANT: every variable prefixed with VITE_ is bundled into the browser
# JavaScript and is publicly visible. Never put secrets here (for example
# GOOGLE_PLACES_API_KEY, OPENAI_API_KEY, or any backend service credential).
# Those belong only on the Spring Boot backend.

# Base URL of the separate Spring Boot backend. Falls back to http://localhost:8080 when unset.
VITE_API_BASE_URL=http://localhost:8080

# Okta SPA settings (public values; the SPA client has no secret).
# The redirect URI must also be registered as a Sign-in redirect URI in the Okta app.
VITE_OKTA_ISSUER=https://trial-7660317.okta.com/oauth2/default
VITE_OKTA_CLIENT_ID=
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
